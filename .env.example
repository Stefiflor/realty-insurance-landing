# Copiá este archivo a .env.local y completá los valores.
# .env.local está en .gitignore: nunca subas credenciales al repo.

# --- Supabase ---------------------------------------------------------------
# Panel de Supabase > Project Settings > API.
# Mientras estén vacías, la app usa las fixtures de src/lib/db/fixtures.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- WhatsApp ---------------------------------------------------------------
# Número del estudio en formato internacional, sin +, espacios ni guiones.
# Ejemplo para un celular de Buenos Aires: 5491123456789
# Mientras esté vacío, los botones de contacto muestran un placeholder.
NEXT_PUBLIC_WHATSAPP_PHONE=
